{
  "name": "running-average-api",
  "version": "1.0.0",
  "description": "REST API exposing POST /average, which returns the running average of all numbers submitted so far.",
  "main": "src/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "client": "node client/client.js",
    "test": "jest --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": ["src/**/*.js", "!src/server.js"]
  }
}
